# ═══════════════════════════════════════════════════════════════
# Gold Analysis - 環境變數設定
# 複製此檔案為 .env 並填入實際值
# ═══════════════════════════════════════════════════════════════

# ─── Alpaca 現貨/期貨 API ───────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Alpaca API 端點
#   即時交易帳號: https://api.alpaca.markets
#   經紀商帳號:   https://broker-api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 是否使用 Paper Trading（模擬交易，無實際風險）
#   true  = Paper Trading（推薦開發/測試用）
#   false = Live Trading（真實資金）
ALPACA_PAPER=true

# ─── OANDA 外匯 API（預留） ───────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# ─── 通用設定 ─────────────────────────────────────────────────
# 交易所客戶端模式切換
#   mock   = 使用 MockExchange（本地模擬，不需要 API Key）
#   alpaca = 使用 AlpacaExchange（需要 API Key）
#   oanda  = 使用 OANDA 適配器（需要 API Key）
EXCHANGE_MODE=mock

# 風險控制
RISK_MAX_POSITION_VALUE_PCT=0.20
RISK_MAX_ORDER_VALUE=50000
RISK_MAX_DAILY_LOSS=1000

# 日誌級別 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# 資料庫
DB_PATH=gold_analysis.db
